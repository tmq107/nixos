#!/usr/bin/env bash
set -euo pipefail

REGION="${REGION:-eu-central-1}"
EXCLUDE_PATTERN="${EXCLUDE_PATTERN:-feature|restored}"
REASON="${REASON:-before-deployment}"
DRY_RUN="${DRY_RUN:-true}"

normalize_cluster_id() {
  local cluster_id="$1"

  cluster_id=$(echo "$cluster_id" | sed -E 's/-?[0-9]{14,}$//')
  cluster_id=$(echo "$cluster_id" | sed -E 's/-alt-cluster$//')
  cluster_id=$(echo "$cluster_id" | sed -E 's/-autocare-[0-9]+-cluster$//')

  echo "$cluster_id"
}

mapfile -t CLUSTER_IDS < <(
  aws rds describe-db-clusters \
    --region "$REGION" \
    --query "DBClusters[*].[DBClusterIdentifier]" \
    --output text |
  grep -Ev "$EXCLUDE_PATTERN" |
  fzf -m --header="Select Aurora cluster(s)" \
)

if [ "${#CLUSTER_IDS[@]}" -eq 0 ]; then
  echo "No cluster selected."
  exit 1
fi

declare -a SNAPSHOT_IDS=()
declare -A SNAPSHOT_BY_CLUSTER=()
declare -A CLUSTER_BY_SNAPSHOT=()

for CLUSTER_ID in "${CLUSTER_IDS[@]}"; do
  BASE_CLUSTER_ID=$(normalize_cluster_id "$CLUSTER_ID")
  SNAPSHOT_ID="manual-${BASE_CLUSTER_ID}-$(date +%y%m%d)-${REASON}"

  SNAPSHOT_IDS+=("$SNAPSHOT_ID")
  SNAPSHOT_BY_CLUSTER["$CLUSTER_ID"]="$SNAPSHOT_ID"
  CLUSTER_BY_SNAPSHOT["$SNAPSHOT_ID"]="$CLUSTER_ID"

done

echo "Region: $REGION"
echo "Clusters:"
for CLUSTER_ID in "${CLUSTER_IDS[@]}"; do
  printf '  - %s -> %s\n' "$CLUSTER_ID" "${SNAPSHOT_BY_CLUSTER[$CLUSTER_ID]}"
done
echo

if [ "$DRY_RUN" = true ]; then
  echo "[DRY RUN] Would run:"
  for CLUSTER_ID in "${CLUSTER_IDS[@]}"; do
    SNAPSHOT_ID="${SNAPSHOT_BY_CLUSTER[$CLUSTER_ID]}"
    printf 'aws rds create-db-cluster-snapshot --region %q --db-cluster-identifier %q --db-cluster-snapshot-identifier %q\n' \
      "$REGION" "$CLUSTER_ID" "$SNAPSHOT_ID"
  done
  exit 0
fi

START_TIME=$(date +%s)

for CLUSTER_ID in "${CLUSTER_IDS[@]}"; do
  SNAPSHOT_ID="${SNAPSHOT_BY_CLUSTER[$CLUSTER_ID]}"
  echo "Creating snapshot: $SNAPSHOT_ID"
  aws rds create-db-cluster-snapshot \
    --region "$REGION" \
    --db-cluster-identifier "$CLUSTER_ID" \
    --db-cluster-snapshot-identifier "$SNAPSHOT_ID" > /dev/null
done

echo "Snapshot creation started."
echo "Checking snapshot status..."

declare -A DONE_STATUS=()
COMPLETED=0
TOTAL=${#SNAPSHOT_IDS[@]}

while [ "$COMPLETED" -lt "$TOTAL" ]; do
  for SNAPSHOT_ID in "${SNAPSHOT_IDS[@]}"; do
    if [ -n "${DONE_STATUS[$SNAPSHOT_ID]:-}" ]; then
      continue
    fi

    STATUS=$(
      aws rds describe-db-cluster-snapshots \
        --region "$REGION" \
        --db-cluster-snapshot-identifier "$SNAPSHOT_ID" \
        --query "DBClusterSnapshots[0].Status" \
        --output text
    )

    NOW=$(date '+%Y-%m-%d %H:%M:%S')
    CLUSTER_ID="${CLUSTER_BY_SNAPSHOT[$SNAPSHOT_ID]}"
    echo "$NOW - $CLUSTER_ID - $SNAPSHOT_ID - status: $STATUS"

    if [ "$STATUS" = "available" ]; then
      DONE_STATUS["$SNAPSHOT_ID"]="available"
      COMPLETED=$((COMPLETED + 1))
    elif [ "$STATUS" = "failed" ]; then
      DONE_STATUS["$SNAPSHOT_ID"]="failed"
      COMPLETED=$((COMPLETED + 1))
    fi
  done

  if [ "$COMPLETED" -lt "$TOTAL" ]; then
    sleep 30
  fi
done

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))
MINUTES=$((DURATION / 60))
SECONDS=$((DURATION % 60))

echo
echo "Snapshot results:"
HAS_FAILURE=false
for CLUSTER_ID in "${CLUSTER_IDS[@]}"; do
  SNAPSHOT_ID="${SNAPSHOT_BY_CLUSTER[$CLUSTER_ID]}"
  STATUS="${DONE_STATUS[$SNAPSHOT_ID]}"
  printf '  - %s -> %s (%s)\n' "$CLUSTER_ID" "$SNAPSHOT_ID" "$STATUS"
  if [ "$STATUS" = "failed" ]; then
    HAS_FAILURE=true
  fi
done

echo "Total time: ${MINUTES}m ${SECONDS}s"

if [ "$HAS_FAILURE" = true ]; then
  exit 1
fi
