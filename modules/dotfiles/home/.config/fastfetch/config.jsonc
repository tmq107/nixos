{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/logo/nixos-small.txt",
    "color": { "1": "#4d6fb7", "2": "#77b6e1" },
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 12
    }
  },
  "modules": [
    "break",
    {
      "type": "distro",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "format": "{release}"
    },
    "uptime",
    "packages",
    {
      "type": "users",
      "format": "{name}"
    },
    {
      "type": "shell",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "cpu",
      "temp": false,
      "format": "{name} ({cores-logical}) @ {freq-max}"
    },
    "gpu",
    {
      "type": "memory",
      "format": "{used} / {total}"
    }
  ]
}
